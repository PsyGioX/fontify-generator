{
  "name": "fontify-generator",
  "private": true,
  "version": "1.1.0",
  "description": "Web font CSS/HTML generator for Google Fonts and TTF/OTF/WOFF/WOFF2 files",
  "author": "PsyGioX (https://github.com/PsyGioX)",
  "homepage": "https://github.com/PsyGioX/fontify-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PsyGioX/fontify-generator.git"
  },
  "bugs": {
    "url": "https://github.com/PsyGioX/fontify-generator/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
